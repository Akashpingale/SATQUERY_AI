# =============================================================================
# SatQuery AI - Environment configuration TEMPLATE
# -----------------------------------------------------------------------------
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# Secrets (tokens, keys, passwords) belong here or in a secret manager only -
# never in source code, logs, or the frontend bundle.
# =============================================================================

# ---- General ----
APP_ENV=development                 # development | production | test
APP_NAME=SatQuery AI
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                     # json | console

# ---- Backend API ----
API_HOST=0.0.0.0
API_PORT=8000
API_V1_PREFIX=/api/v1
# Comma-separated list of allowed CORS origins (frontend dev + prod)
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# ---- Database ----
# Leave BLANK for local development: the app then uses a SQLite file at
# <repo>/storage/satquery_dev.db (no database server needed).
# Docker Compose overrides this with a postgresql+psycopg:// URL.
DATABASE_URL=
# Postgres pieces (used by docker-compose and the postgres service):
POSTGRES_USER=satquery
POSTGRES_PASSWORD=change_me_in_local_env
POSTGRES_DB=satquery
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Storage (paths for uploads / artifacts / models) ----
# Relative paths are resolved against the repository root (not the working
# directory). Absolute paths are used as-is - on this machine prefer the D: drive.
STORAGE_DIR=storage
MODELS_DIR=models
DATA_DIR=data
MAX_UPLOAD_MB=200                   # per-file upload size limit
REQUEST_TIMEOUT_SECONDS=120

# ---- Frontend (Vite) ----
# Consumed at build time by the frontend. Must be reachable from the browser.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ---- Model weights cache ----
# Where Hugging Face stores downloaded model weights (~1.2 GB for the Phase 4 baselines).
# Point this at a drive with free space; on this machine prefer D:.
# Weights are downloaded on first use and are never committed to Git.
HF_HOME=./models/hf-cache
# Set to 1 to forbid downloads and use only already-cached weights. Tests always run
# offline; a capability whose weights are missing reports "unavailable" rather than
# fabricating a result.
# HF_HUB_OFFLINE=0

# ---- Model / dataset access (needed for gated models, NOT for the current baselines) ----
# The Phase 4 baselines (flax-community/clip-rsicd-v2, google/owlvit-base-patch32) are
# ungated and need no token. Leave blank unless a gated model/dataset is introduced.
HF_TOKEN=                           # Hugging Face token for gated models/datasets
# OPENAI_API_KEY=                   # optional external model (only if chosen later)
# ANTHROPIC_API_KEY=                # optional external model (only if chosen later)

# ---- Phase 5 remote-sensing adaptation (LoRA adapter) ----
# Directory holding the trained LoRA adapter (adapter_config.json + adapter_model.*).
# Relative paths resolve against the repository root; use an absolute path in Docker,
# where the ml package lives in site-packages. If the directory is missing or empty the
# backend serves the Phase 4 baseline instead and records the fallback in the execution
# trace - it never reports an adapted model that did not load.
PHASE5_ADAPTER_DIR=models/phase5/adapter

# ---- Compute ----
# Local development is CPU-only by default. Phase 5 training used a real CUDA GPU;
# `auto` picks cuda when torch reports a usable device, otherwise cpu.
DEVICE=cpu                          # cpu | cuda | auto
