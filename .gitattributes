# Normalize line endings. Keep LF for scripts/config that run in Linux containers.
* text=auto eol=lf

*.py    text eol=lf
*.ts    text eol=lf
*.tsx   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# Windows batch files stay CRLF
*.bat   text eol=crlf
*.cmd   text eol=crlf

# Binary assets
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.tif   binary
*.tiff  binary
*.safetensors binary
*.pt    binary
*.pth   binary
