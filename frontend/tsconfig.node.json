{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "types": ["node"],
    // `tsc -b` is a build (emitting) mode. Without these, type-checking vite.config.ts
    // emitted vite.config.js next to it, and Vite resolves vite.config.js *before*
    // vite.config.ts - so a stale generated file would silently shadow the real config.
    // Emit goes to a throwaway directory and build info stays out of the repo root.
    "outDir": "./node_modules/.tmp/tsconfig.node",
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
